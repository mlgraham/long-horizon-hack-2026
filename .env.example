# Copy to .env (gitignored) and fill in only what you have. Every key is optional.

# RawTree API key (rt_...): mirrors every event, enables `ledger sync` and the RawTree board
RAWTREE_API_KEY=
# RawTree database to write to (default: the key's default database)
RAWTREE_DATABASE=
# RawTree table name (default ledger_events); set a unique one on a shared cluster
RAWTREE_TABLE=
# Nimble API key: `tick` and `watch` observe through Nimble instead of a direct fetch
NIMBLE_API_KEY=
# Nimble mode for tick/watch: search (default, live search on the topic) or extract (pull --url)
NIMBLE_MODE=
# Distiller model name (default hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF via local Ollama)
LIQUID_MODEL=
# OpenAI-compatible base URL for the distiller (default http://localhost:11434/v1)
LIQUID_BASE_URL=
# Key for a hosted Liquid endpoint (not needed for local Ollama)
LIQUID_API_KEY=
# Black Forest Labs key: enables `ledger pause --cover`
BFL_API_KEY=
# Anthropic key: used by `python -m hosts.loop --backend anthropic`
ANTHROPIC_API_KEY=
# Host name written on every event (default: detected, e.g. claude-code or shell)
LEDGER_HOST=
# The .ledger directory (default: nearest .ledger walking up from the current directory)
LEDGER_DIR=
